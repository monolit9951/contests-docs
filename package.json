{
  "name": "contests-docs",
  "version": "1.0.0",
  "description": "DareBay public documentation",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "prebuild": "npm run check:registry && npm run gen:llms && npm run gen:redirects",
    "docs:build": "npm run prebuild && vitepress build docs && node scripts/finalize-dist.mjs",
    "docs:preview": "vitepress preview docs",
    "check:registry": "node --experimental-strip-types --no-warnings scripts/check-registry.mjs --post",
    "gen:llms": "node --experimental-strip-types --no-warnings scripts/gen-llms.mjs",
    "gen:redirects": "node --experimental-strip-types --no-warnings scripts/gen-nginx-redirects.mjs",
    "gen:addresses": "node --experimental-strip-types --no-warnings scripts/print-addresses.mjs > ADDRESSES.md",
    "gates": "node --experimental-strip-types --no-warnings scripts/url-gates.mjs"
  },
  "devDependencies": {
    "vitepress": "^1.6.3"
  }
}
